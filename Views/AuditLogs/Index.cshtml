@model IEnumerable<AcxiomCRM.Models.AuditLog>

@{
    ViewData["Title"] = "Audit Logs";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Audit Logs</h1>
            <p class="text-muted">
                Track important CRM activities and security events.
            </p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Action</th>
                            <th>Entity</th>
                            <th>Record ID</th>
                            <th>User ID</th>
                            <th>IP Address</th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var log in Model)
                    {
                        <tr>
                            <td>
                                @log.CreatedDate.ToLocalTime()
                            </td>

                            <td>
                                <span class="badge bg-primary">
                                    @log.Action
                                </span>
                            </td>

                            <td>
                                @log.EntityName
                            </td>

                            <td>
                                @log.RecordId
                            </td>

                            <td>
                                @log.UserId
                            </td>

                            <td>
                                @log.IpAddress
                            </td>
                        </tr>
                    }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>