@model IEnumerable<AcxiomCRM.Models.ApplicationUser>

@{
    ViewData["Title"] = "User Management";
    var userRoles =
        ViewBag.UserRoles as Dictionary<string, IList<string>>;
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold">User Management</h1>
        <p class="text-muted mb-0">
            Manage CRM users and their roles
        </p>
    </div>

    <a asp-action="CreateUser" class="btn btn-primary">
        + Create User
    </a>
</div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <h4>No users found</h4>
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>Full Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th>Actions</th>         
                            </tr>

                        </thead>

                        <tbody>

                        @foreach (var user in Model)
                        {
                            var roles =
                                userRoles != null &&
                                userRoles.ContainsKey(user.Id)
                                    ? userRoles[user.Id]
                                    : new List<string>();

                            <tr>

                                <td>
                                    <strong>
                                        @user.FullName
                                    </strong>
                                </td>

                                <td>
                                    @user.Email
                                </td>

                                <td>
                                    @if (roles.Any())
                                    {
                                        foreach (var role in roles)
                                        {
                                            if (role == "Admin")
                                            {
                                                <span class="badge bg-danger me-1">
                                                    Admin
                                                </span>
                                            }
                                            else if (role == "Manager")
                                            {
                                                <span class="badge bg-warning text-dark me-1">
                                                    Manager
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary me-1">
                                                    Sales Executive
                                                </span>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No Role
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td>
                                    @user.CreatedDate
                                        .ToLocalTime()
                                        .ToString("dd MMM yyyy")
                                </td>
                               <td>
    <a asp-action="EditRole"
       asp-route-id="@user.Id"
       class="btn btn-sm btn-outline-primary">
        Edit Role
    </a>
</td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>