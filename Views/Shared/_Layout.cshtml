<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AcxiomCRM</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/AcxiomCRM.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <!-- Brand -->
                <a class="navbar-brand fw-bold"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    AcxiomCRM
                </a>

                <!-- Mobile menu -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- Main navigation -->
                    <ul class="navbar-nav flex-grow-1">

                        <!-- Home -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- Dashboard -->
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    Dashboard
                                </a>
                            </li>

                            <!-- Customers -->
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-controller="Customers"
                                   asp-action="Index">
                                    Customers
                                </a>
                            </li>

                            <!-- Leads -->
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-controller="Leads"
                                   asp-action="Index">
                                    Leads
                                </a>
                            </li>

                            <!-- Follow-Ups -->
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-controller="FollowUps"
                                   asp-action="Index">
                                    Follow-Ups
                                </a>
                            </li>

                            <!-- Opportunities -->
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-controller="Opportunities"
                                   asp-action="Index">
                                    Opportunities
                                </a>
                            </li>

                            <!-- Activities -->
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-controller="Activities"
                                   asp-action="Index">
                                    Activities
                                </a>
                            </li>

                            <!-- Reports -->
                            @if (User.IsInRole("Admin") ||
                                 User.IsInRole("Manager"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-area=""
                                       asp-controller="Reports"
                                       asp-action="Index">
                                        Reports
                                    </a>
                                </li>

                                <!-- Audit Logs -->
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-area=""
                                       asp-controller="AuditLogs"
                                       asp-action="Index">
                                        Audit Logs
                                    </a>
                                </li>
                            }

                            <!-- Admin User Management -->
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark"
                                       asp-area=""
                                       asp-controller="Admin"
                                       asp-action="Index">
                                        User Management
                                    </a>
                                </li>
                            }
                        }

                        <!-- Privacy -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                    </ul>

                    <!-- Login / Logout -->
                    <partial name="_LoginPartial" />

                </div>

            </div>

        </nav>
    </header>

    <!-- Main content -->
    <div class="container">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>

    <!-- Footer -->
    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - AcxiomCRM -

            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">
                Privacy
            </a>

        </div>

    </footer>

    <!-- JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>