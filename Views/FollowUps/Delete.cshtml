@model AcxiomCRM.Models.FollowUp

@{
    ViewData["Title"] = "Delete Follow-Up";
}

<div class="container">

    <div class="mb-4">
        <h1 class="fw-bold text-danger">Delete Follow-Up</h1>
        <p class="text-muted">
            Please confirm before deleting this follow-up.
        </p>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="alert alert-warning">
                <strong>Warning:</strong>
                This action cannot be undone.
            </div>

            <h4 class="mb-4">
                Are you sure you want to delete this follow-up?
            </h4>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <strong>Follow-Up Title</strong>
                    <p class="form-control-plaintext">
                        @Model.Title
                    </p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Status</strong>
                    <p class="form-control-plaintext">
                        @Model.Status
                    </p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Follow-Up Date</strong>
                    <p class="form-control-plaintext">
                        @Model.FollowUpDate
                            .ToLocalTime()
                            .ToString("dd MMM yyyy")
                    </p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Assigned To</strong>
                    <p class="form-control-plaintext">
                        @(Model.AssignedTo ?? "Not Assigned")
                    </p>
                </div>

            </div>

            <hr />

            <form asp-action="Delete" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-danger">
                        Yes, Delete Follow-Up
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>