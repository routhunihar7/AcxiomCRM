@model IEnumerable<AcxiomCRM.Models.FollowUp>

@{
    ViewData["Title"] = "Follow-Ups";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Follow-Ups</h1>
            <p class="text-muted">
                Manage and track customer and lead follow-ups
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Add Follow-Up
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Search and Filter -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row g-2">

                    <div class="col-md-7">
                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Search follow-ups..." />
                    </div>

                    <div class="col-md-3">
                        <select name="status"
                                class="form-select">

                            <option value="">All Statuses</option>

                            @foreach (var status in ViewBag.Statuses)
                            {
                                <option value="@status"
                                        selected="@(ViewBag.Status?.ToString() == status ? "selected" : null)">
                                    @status
                                </option>
                            }

                        </select>
                    </div>

                    <div class="col-md-2">
                        <button type="submit"
                                class="btn btn-dark w-100">
                            Search
                        </button>
                    </div>

                </div>

            </form>

        </div>
    </div>

    <!-- Follow-Up table -->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <h4>No follow-ups found</h4>

                    <p class="text-muted">
                        Start by creating your first follow-up.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        Add Follow-Up
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Title</th>
                                <th>Description</th>
                                <th>Follow-Up Date</th>
                                <th>Status</th>
                                <th>Assigned To</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var followUp in Model)
                        {
                            <tr>

                                <td>
                                    <strong>@followUp.Title</strong>
                                </td>

                                <td>
                                    @(followUp.Description.Length > 50
                                        ? followUp.Description.Substring(0, 50) + "..."
                                        : followUp.Description)
                                </td>

                                <td>
                                    @followUp.FollowUpDate
                                        .ToLocalTime()
                                        .ToString("dd MMM yyyy")
                                </td>

                                <td>

                                    @if (followUp.Status == "Planned")
                                    {
                                        <span class="badge bg-primary">
                                            Planned
                                        </span>
                                    }
                                    else if (followUp.Status == "Completed")
                                    {
                                        <span class="badge bg-success">
                                            Completed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Cancelled
                                        </span>
                                    }

                                </td>

                                <td>
                                    @(followUp.AssignedTo ?? "Not Assigned")
                                </td>

                                <td>

                                    <div class="btn-group">

                                        <a asp-action="Details"
                                           asp-route-id="@followUp.Id"
                                           class="btn btn-sm btn-outline-info">
                                            View
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@followUp.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@followUp.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>