@model AcxiomCRM.Models.Opportunity

@{
    ViewData["Title"] = "Edit Opportunity";
}

<div class="container">

    <div class="mb-4">
        <h1 class="fw-bold">Edit Opportunity</h1>
        <p class="text-muted">
            Update opportunity information
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label">
                            Opportunity Name *
                        </label>

                        <input asp-for="Name"
                               class="form-control" />

                        <span asp-validation-for="Name"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Company" class="form-label">
                            Company
                        </label>

                        <input asp-for="Company"
                               class="form-control" />

                        <span asp-validation-for="Company"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Amount" class="form-label">
                            Amount *
                        </label>

                        <input asp-for="Amount"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control" />

                        <span asp-validation-for="Amount"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Probability"
                               class="form-label">
                            Probability (%) *
                        </label>

                        <input asp-for="Probability"
                               type="number"
                               min="0"
                               max="100"
                               class="form-control" />

                        <span asp-validation-for="Probability"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Stage"
                               class="form-label">
                            Stage *
                        </label>

                        <select asp-for="Stage"
                                class="form-select">

                            @foreach (var stage in ViewBag.Stages)
                            {
                                <option value="@stage">
                                    @stage
                                </option>
                            }

                        </select>

                        <span asp-validation-for="Stage"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Status"
                               class="form-label">
                            Status *
                        </label>

                        <select asp-for="Status"
                                class="form-select">

                            @foreach (var status in ViewBag.Statuses)
                            {
                                <option value="@status">
                                    @status
                                </option>
                            }

                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ExpectedCloseDate"
                               class="form-label">
                            Expected Close Date *
                        </label>

                        <input asp-for="ExpectedCloseDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="ExpectedCloseDate"
                              class="text-danger"></span>

                        <small class="text-muted">
                            Active opportunities cannot have a past
                            close date.
                        </small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="CustomerId"
                               class="form-label">
                            Customer ID
                        </label>

                        <input asp-for="CustomerId"
                               type="number"
                               class="form-control" />

                        <span asp-validation-for="CustomerId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="LeadId"
                               class="form-label">
                            Lead ID
                        </label>

                        <input asp-for="LeadId"
                               type="number"
                               class="form-control" />

                        <span asp-validation-for="LeadId"
                              class="text-danger"></span>
                    </div>

                </div>

                <hr />

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Update Opportunity
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}