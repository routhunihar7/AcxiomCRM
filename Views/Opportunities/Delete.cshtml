@model AcxiomCRM.Models.Opportunity

@{
    ViewData["Title"] = "Delete Opportunity";
}

<div class="container">

    <div class="mb-4">
        <h1 class="fw-bold text-danger">Delete Opportunity</h1>
        <p class="text-muted">
            Please confirm before deleting this opportunity.
        </p>
    </div>

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="alert alert-warning">
                <strong>Warning:</strong>
                This action cannot be undone.
            </div>

            <h4 class="mb-4">
                Are you sure you want to delete this opportunity?
            </h4>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <strong>Opportunity Name</strong>
                    <p class="form-control-plaintext">
                        @Model.Name
                    </p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Company</strong>
                    <p class="form-control-plaintext">
                        @(Model.Company ?? "N/A")
                    </p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Amount</strong>
                    <p class="form-control-plaintext">
                        ₹@Model.Amount.ToString("N2")
                    </p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Probability</strong>
                    <p class="form-control-plaintext">
                        @Model.Probability%
                    </p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Stage</strong>
                    <p class="form-control-plaintext">
                        @Model.Stage
                    </p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Status</strong>
                    <p class="form-control-plaintext">
                        @Model.Status
                    </p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Expected Close Date</strong>
                    <p class="form-control-plaintext">
                        @Model.ExpectedCloseDate
                            .ToLocalTime()
                            .ToString("dd MMM yyyy")
                    </p>
                </div>

            </div>

            <hr />

            <form asp-action="Delete" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-danger">
                        Yes, Delete Opportunity
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>