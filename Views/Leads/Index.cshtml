@model IEnumerable<AcxiomCRM.Models.Lead>

@{
    ViewData["Title"] = "Leads";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Leads</h1>
            <p class="text-muted">
                Manage and track your sales leads
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Add Lead
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Search and Filter -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row g-2">

                    <div class="col-md-7">
                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Search by name, email, phone or company..." />
                    </div>

                    <div class="col-md-3">

                        <select name="status"
                                class="form-select">

                            <option value="">All Statuses</option>

                            @foreach (var status in ViewBag.Statuses)
                            {
                                <option value="@status"
                                        selected="@(ViewBag.Status?.ToString() == status ? "selected" : null)">
                                    @status
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-md-2">

                        <button type="submit"
                                class="btn btn-dark w-100">
                            Search
                        </button>

                    </div>

                </div>

            </form>

        </div>
    </div>

    <!-- Leads table -->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <h4>No leads found</h4>

                    <p class="text-muted">
                        Start by adding your first lead.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        Add Lead
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>Name</th>
                                <th>Company</th>
                                <th>Email</th>
                                <th>Status</th>
                                <th>Expected Value</th>
                                <th>Source</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>

                        </thead>

                        <tbody>

                        @foreach (var lead in Model)
                        {
                            <tr>

                                <td>
                                    <strong>@lead.Name</strong>
                                </td>

                                <td>
                                    @lead.Company
                                </td>

                                <td>
                                    @lead.Email
                                </td>

                                <td>

                                    @if (lead.Status == "New")
                                    {
                                        <span class="badge bg-primary">
                                            New
                                        </span>
                                    }
                                    else if (lead.Status == "Contacted")
                                    {
                                        <span class="badge bg-info">
                                            Contacted
                                        </span>
                                    }
                                    else if (lead.Status == "Qualified")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Qualified
                                        </span>
                                    }
                                    else if (lead.Status == "Converted")
                                    {
                                        <span class="badge bg-success">
                                            Converted
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Lost
                                        </span>
                                    }

                                </td>

                                <td>
                                    ₹@lead.ExpectedValue.ToString("N2")
                                </td>

                                <td>
                                    @lead.Source
                                </td>

                                <td>
                                    @lead.CreatedDate
                                        .ToLocalTime()
                                        .ToString("dd MMM yyyy")
                                </td>

                                <td>

                                    <div class="btn-group">

                                        <a asp-action="Details"
                                           asp-route-id="@lead.Id"
                                           class="btn btn-sm btn-outline-info">
                                            View
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@lead.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@lead.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>